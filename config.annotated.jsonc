{
  // ==============================================================================
  // ARCH LINUX AUTOMATED INSTALLER - CONFIGURATION FILE (JSON with Comments)
  // Comments (// and #) are fully supported and will be automatically stripped.
  // ==============================================================================

  "system": {
    // Machine hostname (e.g., "archlinux", "workstation", "arch-vm")
    "hostname": "archlinux",

    // Timezone: Any valid timezone from /usr/share/zoneinfo/
    // Examples: "Asia/Manila", "America/New_York", "Europe/London", "UTC"
    "timezone": "Asia/Manila",

    // System Locale: Must match an entry in /etc/locale.gen
    // Examples: "en_US.UTF-8", "en_GB.UTF-8", "fil_PH.UTF-8", "ja_JP.UTF-8"
    "locale": "en_US.UTF-8",

    // Console Keymap: Keyboard layout for TTY console
    // Examples: "us", "uk", "de-latin1", "fr"
    "keymap": "us"
  },

  "storage": {
    // Storage Mode:
    // - "clean_install": Wipes and partitions a dedicated drive automatically.
    // - "dual_boot": Reuses existing partitions (e.g., alongside Windows) without wiping the disk.
    "mode": "clean_install",

    // Target Storage Device (Used in "clean_install" mode):
    // Examples:
    //   - NVMe SSD:        "/dev/nvme0n1"
    //   - SATA SSD / HDD:  "/dev/sda" or "/dev/sdb"
    //   - QEMU / KVM VM:   "/dev/vda" (VirtIO disk)
    //   - VirtualBox VM:   "/dev/sda"
    //   - SD Card / eMMC:  "/dev/mmcblk0"
    "device": "/dev/nvme0n1",

    // Safety wipe flag (true / false)
    "wipe": true,

    // EFI System Partition size (e.g., "512M", "1024M", "1G")
    "efi_size": "1024M",

    // Swap partition size:
    // Examples: "4G", "8G", "16G", or "none" (if you don't want a swap partition)
    "swap_size": "8G",

    // LUKS Disk Encryption:
    "encryption": {
      // Set to true to encrypt root with LUKS2, or false to disable
      "enabled": true,

      // LUKS type: "luks2" (recommended) or "luks1"
      "type": "luks2",

      // Device mapper name (creates /dev/mapper/cryptroot)
      "device_name": "cryptroot",

      // Encryption Passphrase:
      // - null: Prompts you interactively and securely with masked input during install (RECOMMENDED)
      // - "YourSecretPassword": Hardcoded password (not recommended for git repos)
      "password": null
    },

    // LVM (Logical Volume Management):
    "lvm": {
      // Set to true to create LVM on top of LUKS/partition, false otherwise
      "enabled": false,
      "vg_name": "vg0",
      "volumes": [
        { "name": "swap", "size": "8G", "fs": "swap" },
        { "name": "root", "size": "50G", "fs": "ext4", "mount": "/" },
        { "name": "home", "size": "remainder", "fs": "ext4", "mount": "/home" }
      ]
    },

    // Filesystem Configuration:
    "filesystem": {
      // Filesystem type: "btrfs" or "ext4"
      "type": "btrfs",

      // If type is "btrfs", specify subvolumes (Snapper & Timeshift compatible layout):
      "btrfs_subvolumes": [
        { "name": "@", "mount": "/" },
        { "name": "@home", "mount": "/home" },
        { "name": "@snapshots", "mount": "/.snapshots" },
        { "name": "@var_log", "mount": "/var/log" }
      ],

      // Mount options for filesystem:
      // For Btrfs: ["noatime", "compress=zstd:1"]
      // For Ext4:  ["noatime"]
      "mount_options": ["noatime", "compress=zstd:1"]
    },

    // ==========================================================================
    // DUAL BOOT CONFIGURATION (Used ONLY when "mode": "dual_boot"):
    // ==========================================================================
    "partitions": {
      "efi": {
        // Your existing EFI partition (e.g., Windows EFI):
        "device": "/dev/nvme0n1p1",
        // IMPORTANT: Keep "format": false so Windows bootloader is NOT erased!
        "format": false,
        "mount": "/boot"
      },
      "root": {
        // Target partition for Arch Linux:
        "device": "/dev/nvme0n1p5",
        "format": true
      },
      "swap": {
        // Optional swap partition:
        "device": "/dev/nvme0n1p6",
        "format": true
      }
    }
  },

  // Dual Boot OS detection settings:
  "dual_boot": {
    "enabled": false,
    // Set to true to install os-prober and add Windows to GRUB menu
    "os_prober": true
  },

  "pacman": {
    // Number of simultaneous package downloads (1 to 10)
    "parallel_downloads": 5,

    // Enable 32-bit multilib repository (needed for Steam, Wine, etc.)
    "multilib": true,

    // Enable colored output in pacman
    "color": true
  },

  "mirrors": {
    // Run reflector to automatically rank fastest mirrors
    "reflector": true,

    // Countries to filter mirrors from. Use ["Worldwide"] or e.g. ["Philippines", "Singapore", "United States"]
    "countries": ["Worldwide"],

    // Download protocol: "https" or "http"
    "protocol": "https",

    // Number of most recently synchronized mirrors to rank
    "latest": 10,

    // Sort mirrors by: "rate" (download speed), "score", or "delay"
    "sort": "rate"
  },

  "packages": {
    // Core kernel & system base packages (passed to pacstrap):
    "base": [
      "base",
      "base-devel",
      "linux",
      "linux-firmware",
      "linux-headers"
    ],

    // CPU Microcode:
    // - "auto": Auto-detects Intel vs AMD from /proc/cpuinfo
    // - "intel-ucode": Force Intel microcode
    // - "amd-ucode": Force AMD microcode
    "ucode": "auto",

    // Essential system utilities:
    "system": [
      "networkmanager",
      "git",
      "vim",
      "neovim",
      "sudo",
      "openssh",
      "curl",
      "wget",
      "zsh"
    ],

    // Additional tools, desktop packages, or dev dependencies:
    "additional": [
      "docker",
      "docker-compose",
      "htop",
      "tmux",
      "rsync"
    ]
  },

  "bootloader": {
    // Bootloader type:
    // - "systemd-boot": Modern, minimal UEFI bootloader (fastest)
    // - "grub": Feature-rich bootloader (required for BIOS/Legacy mode, and recommended for Dual Boot)
    "type": "systemd-boot"
  },

  "users": {
    // Root password:
    // - null: Prompts interactively with masked input (RECOMMENDED)
    // - "password123": Hardcoded password string
    "root_password": null,

    // Regular user accounts to create:
    "accounts": [
      {
        "username": "alvin",
        // User password: null for interactive masked prompt
        "password": null,
        // Groups user belongs to (wheel gives sudo access)
        "groups": ["wheel", "storage", "power", "docker"],
        // Login shell: "/bin/bash", "/bin/zsh", "/bin/fish"
        "shell": "/bin/bash",
        // Passwordless sudo (true / false)
        "sudo_nopasswd": false
      }
    ]
  },

  // Systemd services to automatically enable (systemctl enable <service>):
  "services": [
    "NetworkManager",
    "docker",
    "sshd"
  ],

  // Custom post-install shell commands executed inside arch-chroot before reboot:
  "post_install": {
    "commands": [
      // Example: "systemctl enable fstrim.timer"
    ]
  }
}

