{
  // ==============================================================================
  // ARCH LINUX AUTO-INSTALLER - MASTER CONFIGURATION
  // Single config file for everything: PC, Laptop, VM, NVMe, SSD, HDD, LUKS, etc.
  // Comments (//) are fully supported and will not cause errors.
  // ==============================================================================

  "system": {
    "hostname": "archlinux",               // Name of your computer
    "timezone": "Asia/Manila",             // Timezone (e.g. Asia/Manila, UTC, America/New_York)
    "locale": "en_US.UTF-8",               // System locale
    "keymap": "us"                         // Console keymap (us, uk, de, etc.)
  },

  "storage": {
    // --------------------------------------------------------------------------
    // 1. INSTALLATION MODE:
    //    "clean_install" = Wipes and formats the target disk (standard install).
    //    "dual_boot"     = Preserves existing partitions (e.g. alongside Windows).
    // --------------------------------------------------------------------------
    "mode": "clean_install",

    // --------------------------------------------------------------------------
    // 2. TARGET DISK (Used if mode is "clean_install"):
    //    For NVMe SSD (M.2):        "/dev/nvme0n1"
    //    For SATA SSD or HDD:       "/dev/sda"
    //    For Virtual Machine (VM):  "/dev/vda" (QEMU/KVM) or "/dev/sda" (VirtualBox)
    // --------------------------------------------------------------------------
    "device": "/dev/nvme0n1",

    "wipe": true,                          // Safety confirm: true to wipe disk
    "efi_size": "1024M",                   // EFI partition size (e.g. 512M, 1024M, 1G)

    // --------------------------------------------------------------------------
    // 3. SWAP PARTITION (OPTIONAL):
    //    Set "enabled": true  = Creates a swap partition with the specified size.
    //    Set "enabled": false = NO swap partition will be created.
    // --------------------------------------------------------------------------
    "swap": {
      "enabled": false,                    // true = with swap, false = WITHOUT swap partition
      "size": "8G"                         // Swap partition size (e.g. "4G", "8G", "16G")
    },

    // --------------------------------------------------------------------------
    // 4. LUKS DISK ENCRYPTION:
    //    Set "enabled": true to encrypt your disk with LUKS2, or false to disable.
    // --------------------------------------------------------------------------
    "encryption": {
      "enabled": false,                    // true = Enable LUKS, false = Plain unencrypted
      "type": "luks2",
      "device_name": "cryptroot",
      "password": null                     // null = Asks you for password during install (safe)
    },

    // --------------------------------------------------------------------------
    // 5. LVM (Logical Volume Management):
    //    Gawing true kung gusto mong ilagay ang filesystem (ext4 o btrfs)
    //    sa loob ng LVM (pwede ring pagsamahin sa LUKS encryption: LVM on LUKS).
    // --------------------------------------------------------------------------
    "lvm": {
      "enabled": false,                    // true = Filesystem inside LVM, false = Standard partitions
      "vg_name": "vg0"                     // Volume group name
    },

    // --------------------------------------------------------------------------
    // 6. ROOT AT HOME PARTITION (COMBINED vs SEPARATE):
    //    "enabled": false = MAGKASAMA NA ang root at home sa iisang partition/volume (DEFAULT).
    //    "enabled": true  = HIWALAY na partition o LV para sa /home.
    // --------------------------------------------------------------------------
    "separate_home": {
      "enabled": false,                    // false = MAGKASAMA (Default), true = HIWALAY
      "root_size": "50G"                   // Laki ng root kung hiwalay (at ang /home ang kukuha ng remainder)
    },

    // --------------------------------------------------------------------------
    // 7. FILESYSTEM CHOICE (Gagana kahit naka-LVM o hindi):
    //    "btrfs" = Modern, may subvolumes (@, @home, @snapshots), zstd compress
    //    "ext4"  = Classic, subok at pinakasimple.
    // --------------------------------------------------------------------------
    "filesystem": {
      "type": "btrfs",                     // "btrfs" or "ext4"
      "btrfs_subvolumes": [
        { "name": "@", "mount": "/" },
        { "name": "@home", "mount": "/home" },
        { "name": "@snapshots", "mount": "/.snapshots" },
        { "name": "@var_log", "mount": "/var/log" }
      ],
      "mount_options": ["noatime", "compress=zstd:1"]  // For ext4 use: ["noatime"]
    },

    // --------------------------------------------------------------------------
    // 7. DUAL BOOT PARTITIONS (Used ONLY if "mode": "dual_boot"):
    // --------------------------------------------------------------------------
    "partitions": {
      "efi": {
        "device": "/dev/nvme0n1p1",        // Existing EFI partition (Windows)
        "format": false,                   // KEEP FALSE so Windows is NOT erased!
        "mount": "/boot"
      },
      "root": {
        "device": "/dev/nvme0n1p2",        // Target Arch partition
        "format": true
      },
      "swap": {
        "device": "/dev/nvme0n1p3",        // Optional swap partition
        "enabled": false,                   // true = use swap partition, false = skip swap
        "format": true
      }
    }
  },

  // ----------------------------------------------------------------------------
  // DUAL BOOT OS-PROBER (Adds Windows to the boot menu):
  // ----------------------------------------------------------------------------
  "dual_boot": {
    "enabled": false,                      // true = Detect and add Windows, false = Arch only
    "os_prober": true
  },

  // ----------------------------------------------------------------------------
  // PACMAN & MIRRORS:
  // ----------------------------------------------------------------------------
  "pacman": {
    "parallel_downloads": 5,               // Simultaneous downloads (1 to 10)
    "multilib": true,                      // 32-bit apps (Steam, Wine, Discord)
    "color": true
  },
  "mirrors": {
    "reflector": true,                     // Auto-find fastest mirrors
    "countries": ["Worldwide"],            // Or e.g. ["Philippines", "Singapore"]
    "protocol": "https",
    "latest": 10,
    "sort": "rate"
  },

  // ----------------------------------------------------------------------------
  // PACKAGES:
  // ----------------------------------------------------------------------------
  "packages": {
    "base": ["base", "base-devel", "linux", "linux-firmware", "linux-headers"],
    "ucode": "auto",                       // "auto" detects Intel vs AMD automatically
    "system": [
      "networkmanager",
      "git",
      "vim",
      "neovim",
      "sudo",
      "openssh",
      "curl",
      "wget",
      "zsh"
    ],
    "additional": [
      "docker",
      "docker-compose",
      "htop",
      "tmux",
      "rsync"
    ]
  },

  // ----------------------------------------------------------------------------
  // BOOTLOADER:
  // "systemd-boot" = Fastest and cleanest for UEFI
  // "grub"         = Recommended for Dual-Boot or Legacy BIOS
  // ----------------------------------------------------------------------------
  "bootloader": {
    "type": "systemd-boot"
  },

  // ----------------------------------------------------------------------------
  // USER ACCOUNTS & PASSWORDS:
  // Tip: Leaving password as null will prompt you securely during install!
  // ----------------------------------------------------------------------------
  "users": {
    "root_password": null,                 // null = asks you during install
    "accounts": [
      {
        "username": "alvin",
        "password": null,                  // null = asks you during install
        "groups": ["wheel", "storage", "power", "docker"],
        "shell": "/bin/bash",
        "sudo_nopasswd": false
      }
    ]
  },

  // ----------------------------------------------------------------------------
  // SYSTEMD SERVICES TO ENABLE:
  // ----------------------------------------------------------------------------
  "services": [
    "NetworkManager",
    "docker",
    "sshd"
  ],

  // ----------------------------------------------------------------------------
  // OPTIONAL POST-INSTALL SHELL COMMANDS:
  // ----------------------------------------------------------------------------
  "post_install": {
    "commands": [
      // "systemctl enable fstrim.timer"
    ]
  }
}
