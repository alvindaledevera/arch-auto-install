{
  "system": {
    "hostname": "arch-dualboot",
    "timezone": "Asia/Manila",
    "locale": "en_US.UTF-8",
    "keymap": "us"
  },
  "storage": {
    "mode": "dual_boot",
    "partitions": {
      "efi": {
        "device": "/dev/nvme0n1p1",
        "format": false,
        "mount": "/boot"
      },
      "root": {
        "device": "/dev/nvme0n1p5",
        "format": true
      },
      "swap": {
        "device": "/dev/nvme0n1p6",
        "format": true
      }
    },
    "encryption": {
      "enabled": false
    },
    "filesystem": {
      "type": "ext4",
      "mount_options": ["noatime"]
    }
  },
  "dual_boot": {
    "enabled": true,
    "os_prober": true
  },
  "pacman": {
    "parallel_downloads": 5,
    "multilib": true,
    "color": true
  },
  "mirrors": {
    "reflector": true,
    "countries": ["Worldwide"],
    "protocol": "https",
    "latest": 10,
    "sort": "rate"
  },
  "packages": {
    "base": [
      "base",
      "base-devel",
      "linux",
      "linux-firmware",
      "linux-headers"
    ],
    "ucode": "auto",
    "system": [
      "networkmanager",
      "git",
      "vim",
      "sudo",
      "openssh",
      "curl"
    ],
    "additional": [
      "htop"
    ]
  },
  "bootloader": {
    "type": "grub"
  },
  "users": {
    "root_password": null,
    "accounts": [
      {
        "username": "archuser",
        "password": null,
        "groups": ["wheel", "storage", "power"],
        "shell": "/bin/bash",
        "sudo_nopasswd": false
      }
    ]
  },
  "services": [
    "NetworkManager"
  ],
  "post_install": {
    "commands": []
  }
}

